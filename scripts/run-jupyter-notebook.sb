#!/bin/bash --login
#SBATCH --job-name="dianne"
#SBATCH --nodes=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120GB
#SBATCH -e err_jupyter.err
#SBATCH -o out_jupyter.out
#SBATCH --export=ALL

cd $SLURM_SUBMIT_DIR
unset XDG_RUNTIME_DIR
module load singularity

IP=$(hostname -i)
PORT=$(shuf -i10000-11999 -n1)

export PYTHONUNBUFFERED=1

singularity exec ${NV_FLAG:-} -B /projects/ --env PYTHONUNBUFFERED=1 "$CONTAINER" \
    stdbuf -oL -eL jupyter notebook --no-browser --port=$PORT --ip=$IP --notebook-dir ../
